{
  "name": "community-health-center-patient-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Barangay / Community Health Center Patient Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:all": "npm run build --workspaces",
    "preview": "npm run preview --workspace=client",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "start": "npm run dev --workspace=client",
    "start:server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}